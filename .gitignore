# ==============================================================
# SecureCore IDS — Root .gitignore
# ==============================================================

# User-specified exclusions
lycostand/

# Environment and secrets (NEVER commit secrets or credentials)
.env
.env.*
!.env.example
*.env
our_key_file/
*.pem
*.key
*firebase*.json
cookies.txt
*cookies*.txt

# Python virtual environments
finalProjectCS4/
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
htmlcov/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
client/dist/
client/dist-ssr/
*.local

# Database & Runtime Data
*.sqlite
*.sqlite3
*.db
instance/
data/*.db

# Logs
logs/
*.log

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Temporary & intermediate stress test artifacts
stress-tests/results/*.csv
